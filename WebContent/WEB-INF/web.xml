<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <!-- Uses login.jsp as the landing page -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- Authentication Filter -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.iacademy.cselec05.inventory.filter.AuthenticationFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Authorization Filter (Admin Only) -->
    <filter>
        <filter-name>AuthorizationFilter</filter-name>
        <filter-class>com.iacademy.cselec05.inventory.filter.AuthorizationFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/register</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/create-room</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/edit-room</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/create-item</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/edit-item</url-pattern>
    </filter-mapping>

    <!--  Login Servlet  -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.iacademy.cselec05.inventory.servlet.auth.LoginServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!--  Logout Servlet  -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.iacademy.cselec05.inventory.servlet.auth.LogoutServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!--  Home Servlet  -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.iacademy.cselec05.inventory.servlet.HomeServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!--  Register User Servlet  -->
    <servlet>
        <servlet-name>RegisterUserServlet</servlet-name>
        <servlet-class>com.iacademy.cselec05.inventory.servlet.user.RegisterUserServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegisterUserServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!--  Create Room Servlet  -->
    <servlet>
        <servlet-name>CreateRoomServlet</servlet-name>
        <servlet-class>com.iacademy.cselec05.inventory.servlet.room.CreateRoomServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CreateRoomServlet</servlet-name>
        <url-pattern>/create-room</url-pattern>
    </servlet-mapping>

    <!--  Edit Room Servlet  -->
    <servlet>
        <servlet-name>EditRoomServlet</servlet-name>
        <servlet-class>com.iacademy.cselec05.inventory.servlet.room.EditRoomServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>EditRoomServlet</servlet-name>
        <url-pattern>/edit-room</url-pattern>
    </servlet-mapping>

    <!--  Room List Servlet  -->
    <servlet>
        <servlet-name>RoomListServlet</servlet-name>
        <servlet-class>com.iacademy.cselec05.inventory.servlet.room.RoomListServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RoomListServlet</servlet-name>
        <url-pattern>/room-list</url-pattern>
    </servlet-mapping>

    <!--  Create Item Servlet  -->
    <servlet>
        <servlet-name>CreateItemServlet</servlet-name>
        <servlet-class>com.iacademy.cselec05.inventory.servlet.item.CreateItemServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CreateItemServlet</servlet-name>
        <url-pattern>/create-item</url-pattern>
    </servlet-mapping>

    <!--  Edit Item Servlet  -->
    <servlet>
        <servlet-name>EditItemServlet</servlet-name>
        <servlet-class>com.iacademy.cselec05.inventory.servlet.item.EditItemServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>EditItemServlet</servlet-name>
        <url-pattern>/edit-item</url-pattern>
    </servlet-mapping>

    <!--  Item List Servlet  -->
    <servlet>
        <servlet-name>ItemListServlet</servlet-name>
        <servlet-class>com.iacademy.cselec05.inventory.servlet.item.ItemListServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ItemListServlet</servlet-name>
        <url-pattern>/item-list</url-pattern>
    </servlet-mapping>

    <!--  Add/Subtract Item Quantity Servlet  -->
    <servlet>
        <servlet-name>ManageStockServlet</servlet-name>
        <servlet-class>com.iacademy.cselec05.inventory.servlet.item.ManageStockServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ManageStockServlet</servlet-name>
        <url-pattern>/manage-stock</url-pattern>
    </servlet-mapping>

</web-app>